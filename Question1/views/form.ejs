<!DOCTYPE html>
<html>
<head>
    <title>Registration Form</title>
</head>
<body>

<h2>User Registration Form</h2>

<% if(errors.length > 0){ %>
<ul style="color:red;">
    <% errors.forEach(err => { %>
        <li><%= err.msg %></li>
    <% }) %>
</ul>
<% } %>

<form action="/register"
      method="POST"
      enctype="multipart/form-data">

Username:
<input type="text"
       name="username"
       value="<%= old.username || '' %>">
<br><br>

Email:
<input type="email"
       name="email"
       value="<%= old.email || '' %>">
<br><br>

Password:
<input type="password" name="password">
<br><br>

Confirm Password:
<input type="password"
       name="confirmPassword">
<br><br>

Gender:

<input type="radio"
name="gender"
value="Male"
<%= old.gender=="Male" ? "checked" : "" %>>
Male

<input type="radio"
name="gender"
value="Female"
<%= old.gender=="Female" ? "checked" : "" %>>
Female

<br><br>

Hobbies:

<input type="checkbox"
name="hobbies"
value="Cricket"> Cricket

<input type="checkbox"
name="hobbies"
value="Reading"> Reading

<input type="checkbox"
name="hobbies"
value="Music"> Music

<br><br>

Profile Picture:

<input type="file"
name="profilePic">

<br><br>

Other Pictures:

<input type="file"
name="otherPics"
multiple>

<br><br>

<input type="submit"
value="Register">

</form>

</body>
</html>