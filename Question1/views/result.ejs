<!DOCTYPE html>
<html>
<head>
<title>Result</title>

<style>
table{
border-collapse:collapse;
width:70%;
}

table,th,td{
border:1px solid black;
padding:10px;
}

img{
width:120px;
height:120px;
margin:5px;
}
</style>

</head>
<body>

<h2>User Details</h2>

<table>

<tr>
<th>Username</th>
<td><%= data.username %></td>
</tr>

<tr>
<th>Email</th>
<td><%= data.email %></td>
</tr>

<tr>
<th>Gender</th>
<td><%= data.gender %></td>
</tr>

<tr>
<th>Hobbies</th>
<td>
<%= Array.isArray(data.hobbies)
? data.hobbies.join(", ")
: data.hobbies %>
</td>
</tr>

<tr>
<th>Profile Picture</th>
<td>

<img src="/uploads/<%= profilePic %>">

<br>

<a href="/download/<%= profilePic %>">
Download
</a>

</td>
</tr>

<tr>
<th>Other Pictures</th>
<td>

<% otherPics.forEach(pic => { %>

<img src="/uploads/<%= pic %>">

<a href="/download/<%= pic %>">
Download
</a>

<br>

<% }) %>

</td>
</tr>

</table>

</body>
</html>