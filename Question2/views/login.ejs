<!DOCTYPE html>
<html>
<head>
    <title>Login</title>
</head>
<body>

<h2>Login Form</h2>

<p style="color:red;">
    <%= error %>
</p>

<form action="/login" method="POST">

    Username:
    <input type="text"
           name="username">
    <br><br>

    Password:
    <input type="password"
           name="password">
    <br><br>

    <button type="submit">
        Login
    </button>

</form>

</body>
</html>